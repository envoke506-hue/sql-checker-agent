# ========================================================
# SQL Checker Agent 环境配置文件示例
# 复制此文件为 .env 并根据实际环境调整配置
# ========================================================

# 服务运行端口与主机
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development

# 本地 Ollama 配置 (用于本地私有化计算向量 Embedding)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b

# 中转站大模型 API 配置 (用于执行 SQL 审核、推理与规范问答)
RELAY_API_BASE_URL=http://gsccswitch.sepzg.vip/v1
RELAY_API_KEY=your_api_key_here
RELAY_LLM_MODEL=deepseek-flash

# 数据库设计规范文件绝对路径
SPEC_DOC_PATH=D:\WorkData\work_space\项目规范\数据库规范\数据库规范.md
